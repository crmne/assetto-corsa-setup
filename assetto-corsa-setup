#!/usr/bin/env bash
#
# assetto-corsa-setup: make a Steam install of Assetto Corsa playable on Linux,
# with Content Manager and Custom Shaders Patch set up and nothing left to click.
#
# Install Assetto Corsa in Steam, then run this. It is safe to run again.
#
# Based on https://github.com/sihawido/assettocorsa-linux-setup, made
# non-interactive and extended to configure Content Manager. GPL-2.0, like it.

set -euo pipefail

APPID=244210
PROTON_DEFAULT="GE-Proton11-7"        # newest GE-Proton tested with AC + CM
PROTON="${PROTON:-$PROTON_DEFAULT}"
CSP_VERSION_DEFAULT="0.2.11"
CSP_VERSION="${CSP_VERSION:-}"        # set to force (re)installing that version
FIRST_RUN_TIMEOUT=1800                # seconds to wait for Proton's first-run fixes

CACHE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/assetto-corsa-setup"
PLUGIN_CACHE="$CACHE_DIR/plugins"
AC_DESKTOP="$HOME/.local/share/applications/Assetto Corsa.desktop"

FRESH=0
SCALE=""
INSTALL_CSP=1
AC_COMMON=""
PURE_ARCHIVE=""
PURE_MODE=auto
HUD_ARCHIVE=""
HUD_MODE=auto
INSTALL_MOZA_TELEMETRY=1

if [[ -t 1 ]]; then
  bold=$'\033[1m'; yellow=$'\033[33m'; red=$'\033[1;31m'; reset=$'\033[0m'
else
  bold=""; yellow=""; red=""; reset=""
fi

step() { echo "${bold}==>${reset} $*"; }
info() { echo "    $*"; }
warn() { echo "${yellow}warning:${reset} $*" >&2; }
die()  { echo "${red}error:${reset} $*" >&2; exit 1; }

trap 'echo "${red}error:${reset} command failed at line $LINENO: $BASH_COMMAND" >&2' ERR

usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

Sets up Assetto Corsa (Steam app $APPID) on Linux:
  - installs GE-Proton ($PROTON_DEFAULT unless told otherwise) and tells
    Steam to use it for Assetto Corsa
  - installs Content Manager in place of the stock launcher
  - installs Custom Shaders Patch and the fonts both need
  - creates the Wine prefix by running the game once, and waits for it
  - points Content Manager at the game, picks your Steam profile and
    restores its plugins, so it opens ready to use
  - gives Content Manager a proper interface font (Selawik, Microsoft's open
    Segoe UI stand-in) and scales it to match your display

Options:
  --fresh          delete the Wine prefix and rebuild it (game settings, Content
                   Manager settings, presets and plugins are kept)
  --no-csp         do not install Custom Shaders Patch
  --pure ZIP       install your locally downloaded Pure 3.59 ZIP and a natural
                   SDR preset (default: detect Pure 3.59*.zip in Downloads)
  --no-pure        skip local Pure detection and installation
  --hud ZIP        install your local CMRT Essential or Complete HUD ZIP
                   (default: detect Downloads, preferring Complete)
  --no-hud         skip local HUD detection and installation
  --no-moza-telemetry  skip the CSP app that sends exact RPM limits to MOZA
  --proton TAG     GE-Proton release to use: a tag such as GE-Proton11-7, or
                   "latest" (default $PROTON_DEFAULT). Switching rebuilds the
                   Wine prefix, keeping settings as --fresh does.
  --scale N        Content Manager interface scale, e.g. 1.5 (default: your
                   display's scale, set once so later changes in Content
                   Manager are kept; passing it overrides them)
  --ac-path DIR    path to steamapps/common/assettocorsa, if it is not found
  -h, --help       show this help

Environment:
  PROTON           same as --proton
  CSP_VERSION      install this Custom Shaders Patch version, replacing the
                   installed one (default $CSP_VERSION_DEFAULT, only if none is installed)
EOF
}

while (( $# )); do
  case "$1" in
    --fresh) FRESH=1 ;;
    --no-csp) INSTALL_CSP=0 ;;
    --pure) [[ $# -ge 2 && -f "$2" ]] || die "--pure needs a local Pure 3.59 ZIP"; PURE_ARCHIVE="$2"; PURE_MODE=explicit; shift ;;
    --no-pure) PURE_MODE=skip; PURE_ARCHIVE="" ;;
    --hud) [[ $# -ge 2 && -f "$2" ]] || die "--hud needs a local CMRT Essential or Complete HUD ZIP"; HUD_ARCHIVE="$2"; HUD_MODE=explicit; shift ;;
    --no-hud) HUD_MODE=skip; HUD_ARCHIVE="" ;;
    --no-moza-telemetry) INSTALL_MOZA_TELEMETRY=0 ;;
    --proton) [[ $# -ge 2 ]] || die "--proton needs a release tag or latest"; PROTON="$2"; shift ;;
    --scale) [[ $# -ge 2 && "$2" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "--scale needs a number such as 1.5"; SCALE="$2"; shift ;;
    --ac-path) [[ $# -ge 2 ]] || die "--ac-path needs a directory"; AC_COMMON="${2%/}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; die "unknown option: $1" ;;
  esac
  shift
done

[[ "$(id -u)" != "0" ]] || die "do not run this as root"

for bin in curl tar unzip python3 sha512sum pgrep; do
  command -v "$bin" > /dev/null || die "$bin is not installed"
done

mkdir -p "$CACHE_DIR"
TMP="$(mktemp -d "$CACHE_DIR/setup-XXXXXXXX")"
trap 'rm -rf "$TMP"' EXIT

download() { # url destination
  curl -fL --retry 3 --progress-bar -o "$2" "$1" || die "download failed: $1"
}

# ---------------------------------------------------------------- locating --

# Every Steam installation we know about: "kind|directory".
steam_candidates() {
  local native="$HOME/.local/share/Steam"
  if [[ ! -d "$native" ]] && [[ -L "$HOME/.steam/root" ]]; then
    native="$(readlink -f "$HOME/.steam/root")"
  fi
  echo "native|$native"
  echo "flatpak|$HOME/.var/app/com.valvesoftware.Steam/data/Steam"
  echo "snap|$HOME/snap/steam/common/.local/share/Steam"
}

library_paths() { # steam_dir
  local vdf="$1/steamapps/libraryfolders.vdf"
  echo "$1"
  [[ -f "$vdf" ]] && grep -oP '"path"\s+"\K[^"]+' "$vdf" | sed 's|\\\\|/|g'
  return 0
}

find_steam_and_ac() {
  local kind dir lib found_steam=0
  while IFS='|' read -r kind dir; do
    [[ -d "$dir" ]] || continue
    found_steam=1
    if [[ -n "$AC_COMMON" ]]; then
      STEAM_KIND="$kind"; STEAM_DIR="$dir"
      return 0
    fi
    while IFS= read -r lib; do
      if [[ -d "$lib/steamapps/common/assettocorsa" ]]; then
        STEAM_KIND="$kind"; STEAM_DIR="$dir"
        AC_COMMON="$lib/steamapps/common/assettocorsa"
        return 0
      fi
    done < <(library_paths "$dir")
  done < <(steam_candidates)
  (( found_steam )) || die "Steam is not installed"
  die "Assetto Corsa is not installed. Install it in Steam first, or pass --ac-path."
}

STEAM_KIND=""; STEAM_DIR=""
find_steam_and_ac

[[ "$(basename "$AC_COMMON")" == "assettocorsa" && -d "$AC_COMMON" ]] \
  || die "'$AC_COMMON' is not a steamapps/common/assettocorsa directory"
[[ -f "$AC_COMMON/acs.exe" ]] \
  || die "Assetto Corsa in '$AC_COMMON' is incomplete; let Steam finish installing it"

case "$STEAM_KIND" in
  native)  STEAM_CMD=(steam) ;;
  flatpak) STEAM_CMD=(flatpak run com.valvesoftware.Steam) ;;
  snap)    STEAM_CMD=(snap run steam) ;;
esac

STEAMAPPS="${AC_COMMON%/common/assettocorsa}"
COMPATDATA="$STEAMAPPS/compatdata/$APPID"
PFX="$COMPATDATA/pfx"
WIN_USER="$PFX/drive_c/users/steamuser"
AC_DOCS="$WIN_USER/Documents/Assetto Corsa"
CM_DATA="$WIN_USER/AppData/Local/AcTools Content Manager"
CONFIG_BACKUP="$STEAMAPPS/compatdata/$APPID.assetto-corsa-setup"
READY_MARKER="$COMPATDATA/.assetto-corsa-setup-ready"
COMPAT_TOOLS_DIR="$STEAM_DIR/compatibilitytools.d"
WIN_AC_ROOT="Z:${AC_COMMON//\//\\}"

step "Found Assetto Corsa"
info "$AC_COMMON ($STEAM_KIND Steam)"

if [[ "$(findmnt -no FSTYPE --target "$AC_COMMON" 2> /dev/null)" =~ ^(ntfs|ntfs3|fuseblk|exfat|vfat)$ ]]; then
  warn "Assetto Corsa is on a Windows filesystem; Proton games are unreliable there."
fi

# --------------------------------------------------------------- processes --

steam_running() { pgrep -x steam > /dev/null; }
game_session_running() { pgrep -f "SteamLaunch AppId=$APPID" > /dev/null; }
# Wine processes of the launcher / Content Manager and of the simulator itself.
launcher_pids() { pgrep -f '^[A-Za-z]:\\.*\\AssettoCorsa\.exe' || true; }

stop_game_session() {
  local pids i
  pids="$(launcher_pids)"
  # shellcheck disable=SC2086
  [[ -z "$pids" ]] || kill $pids 2> /dev/null || true
  for (( i = 0; i < 30; i++ )); do
    game_session_running || return 0
    sleep 1
  done
  pkill -f "SteamLaunch AppId=$APPID" || true
  sleep 2
}

stop_steam() {
  local i
  steam_running || return 0
  info "Closing Steam so it picks up the change..."
  "${STEAM_CMD[@]}" -shutdown > /dev/null 2>&1 || true
  for (( i = 0; i < 60; i++ )); do
    steam_running || { sleep 2; return 0; }
    sleep 1
  done
  die "Steam did not close; quit it and run this again"
}

if game_session_running || [[ -n "$(launcher_pids)" ]] || pgrep -f '\\acs(_x86)?\.exe' > /dev/null; then
  die "Assetto Corsa or Content Manager is running; close it and run this again"
fi

# --------------------------------------------------------------- local Pure --

# Pure is supplied by the user. No Pure files or download URLs are distributed.
pure_setup() { # check | install
  python3 - "$1" "$PURE_ARCHIVE" "$AC_COMMON" "$AC_DOCS" "$CACHE_DIR" <<'PY_PURE'
import configparser
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import stat
import sys
import tempfile
from datetime import datetime
import zipfile

mode, archive, game, documents, cache = sys.argv[1:]
game, documents, cache = map(Path, (game, documents, cache))
root_name = "Pure 3.59"
required = (
    "extension/weather/Pure LCS/manifest.ini",
    "extension/weather/pure/manifest.ini",
    "extension/weather/Pure LCS/weather.lua",
    "extension/weather-controllers/pureCtrl static/controller.lua",
    "system/cfg/ppfilters/pure.ini",
    "system/cfg/ppfilters/purelcs_scripts/pure.lua",
    "apps/lua/PureConfig/manifest.ini",
)

def ini(path):
    result = configparser.ConfigParser(interpolation=None, strict=False)
    result.optionxform = str
    if path.exists():
        result.read(path, encoding="utf-8-sig")
    return result

def atomic_text(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=".pure-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as out:
            out.write(text)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)

with zipfile.ZipFile(archive) as bundle:
    entries, seen = [], set()
    for member in bundle.infolist():
        name = member.filename
        parts = PurePosixPath(name).parts
        if (not parts or name.startswith("/") or "\\" in name or ".." in parts
                or any(":" in part for part in parts)
                or stat.S_ISLNK(member.external_attr >> 16) or member.flag_bits & 1):
            raise SystemExit("Pure archive contains an unsafe or encrypted entry")
        if member.is_dir() or parts[0] != root_name:
            continue
        rel = PurePosixPath(*parts[1:])
        if str(rel).casefold() in seen:
            raise SystemExit("Pure archive contains duplicate paths")
        seen.add(str(rel).casefold())
        if not rel.parts or rel.parts[0] not in {
            "apps", "content", "extension", "system", "_LICENSE and COPYRIGHT.txt", "description.jsgme"
        }:
            continue
        destination = game / rel
        if not destination.resolve().is_relative_to(game.resolve()) or destination.is_symlink():
            raise SystemExit("Pure destination escapes the game directory")
        entries.append((member, rel))
    paths = {str(rel) for _, rel in entries}
    if not set(required).issubset(paths):
        raise SystemExit("Expected the original Pure 3.59 ZIP, containing the Pure 3.59 folder")
    for rel in required[:2]:
        manifest = configparser.ConfigParser(interpolation=None)
        manifest.read_string(bundle.read(root_name + "/" + rel).decode("utf-8-sig"))
        if manifest.get("ABOUT", "VERSION", fallback="").strip() != "3.59":
            raise SystemExit("Only Pure 3.59 archives are supported")
    if not re.search(rb"__PURE_version\s*=\s*3\.59(?:\s|$)", bundle.read(root_name + "/" + required[2])):
        raise SystemExit("Pure lighting script version does not match 3.59")
    fingerprint = hashlib.sha256(json.dumps([
        (str(rel), member.file_size, member.CRC) for member, rel in entries
    ], sort_keys=True).encode()).hexdigest()
    if mode == "check":
        print("    Verified local Pure 3.59 archive layout and version")
        sys.exit(0)
    if mode != "install":
        raise SystemExit("Unknown Pure operation")
    csp_manifest = game / "extension/config/data_manifest.ini"
    if not (game / "dwrite.dll").is_file() or not csp_manifest.is_file():
        raise SystemExit("Pure needs Custom Shaders Patch; install CSP first")
    # 0.2.3-preview211 is the minimum declared by Pure LCS 3.59.
    csp = ini(csp_manifest)
    try:
        build = csp.getint("VERSION", "SHADERS_PATCH_BUILD")
    except (ValueError, configparser.Error):
        raise SystemExit("Cannot verify the installed CSP build for Pure")
    if build < 2974:
        raise SystemExit("Pure 3.59 needs CSP 0.2.3-preview211 or newer")
    cache.mkdir(parents=True, exist_ok=True)
    install_id = hashlib.sha256(str(game.resolve()).encode()).hexdigest()[:16]
    state_file = cache / "pure" / (install_id + ".json")
    state = json.loads(state_file.read_text()) if state_file.exists() else {}
    complete = state.get("fingerprint") == fingerprint and all((game / rel).is_file() for rel in required)
    backup = cache / "backups" / ("pure-3.59-" + datetime.now().strftime("%Y%m%d-%H%M%S-%f"))
    backed_up = set()

    def preserve(path, category, rel):
        key = str(path)
        if key in backed_up:
            return
        backed_up.add(key)
        destination = backup / category / rel
        if path.exists():
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, destination)
        else:
            backup.mkdir(parents=True, exist_ok=True)
            with (backup / "new-files.txt").open("a") as record:
                record.write(str(path) + "\n")

    if not complete:
        size = sum(member.file_size for member, _ in entries)
        overwritten = sum((game / rel).stat().st_size for _, rel in entries if (game / rel).is_file())
        cache_needed = size + overwritten + 256 * 1024**2
        if cache.stat().st_dev == game.stat().st_dev:
            cache_needed += size
        if shutil.disk_usage(cache).free < cache_needed:
            raise SystemExit("Not enough space to stage and back up Pure in the setup data directory")
        if shutil.disk_usage(game).free < size + 256 * 1024**2:
            raise SystemExit("Not enough space to install Pure in the game directory")
        print("    Checking and staging Pure files (about 5 GB for Highres)...", flush=True)
        with tempfile.TemporaryDirectory(prefix="pure-stage-", dir=cache) as temporary:
            stage = Path(temporary)
            # Validate CRCs for every installed file before changing the game.
            for member, rel in entries:
                target = stage / rel
                target.parent.mkdir(parents=True, exist_ok=True)
                with bundle.open(member) as source, target.open("wb") as out:
                    shutil.copyfileobj(source, out, 1024 * 1024)
            for _, rel in entries:
                preserve(game / rel, "game", rel)
            # Atomic replacement per file, with originals and new paths recorded.
            for _, rel in entries:
                target = game / rel
                target.parent.mkdir(parents=True, exist_ok=True)
                fd, temporary_file = tempfile.mkstemp(prefix=".pure-", dir=target.parent)
                os.close(fd)
                try:
                    shutil.copyfile(stage / rel, temporary_file)
                    os.chmod(temporary_file, 0o644)
                    os.replace(temporary_file, target)
                finally:
                    if os.path.exists(temporary_file):
                        os.unlink(temporary_file)
        print("    Installed Pure 3.59; original files backed up")
    else:
        print("    Pure 3.59 is already installed")

    first_setup = not state.get("configured")
    def update_ini(path, category, rel, values, force=False):
        import io
        settings = ini(path)
        changed = False
        for section, pairs in values.items():
            if not settings.has_section(section):
                settings.add_section(section)
            for key, value in pairs.items():
                if (force or not settings.has_option(section, key)) and settings.get(section, key, fallback=None) != value:
                    settings.set(section, key, value)
                    changed = True
        if changed:
            preserve(path, category, rel)
            out = io.StringIO()
            settings.write(out, space_around_delimiters=False)
            atomic_text(path, out.getvalue())

    # Apply the SDR preset once; later runs keep the user's adjustments.
    for rel, values in {
        "video.ini": {"POST_PROCESS": {"ENABLED": "1", "FILTER": "pure", "DOF": "0", "FXAA": "1"},
                      "VIDEO": {"ANISOTROPIC": "16"}},
        "exposure.ini": {"EXPOSURE": {"VALUE": "1"}},
        "extension/weather_fx.ini": {"BASIC": {"ENABLED": "1", "IMPLEMENTATION": "Pure LCS", "CONTROLLER": "pureCtrl static"}},
        "extension/dxgi_tweaks.ini": {"HDR": {"ENABLED": "0"}},
    }.items():
        update_ini(documents / "cfg" / rel, "cfg", rel, values, force=first_setup)
    rel = "extension/config-ext/Pure LCS/scriptsettings/pure_ScriptSettings.ini"
    # Existing Pure app settings are personal; only fill in missing values.
    update_ini(game / rel, "game", rel, {"PureScriptSettings": {
        "script_version": "3.0", "photo-realistic": "0.25", "soft-look": "0.25",
        "exposure-uplift": "0.10", "Activate%20speed-related%20DOF": "false",
    }})
    state.update(version="3.59", fingerprint=fingerprint, configured=True, game=str(game.resolve()))
    if backup.exists():
        state["last_backup"] = str(backup)
        print("    Backup: " + str(backup))
    atomic_text(state_file, json.dumps(state, indent=2) + "\n")
    print("    Pure LCS + Pure filter configured for natural SDR lighting" if first_setup
          else "    Existing graphics preferences preserved")
PY_PURE
}

if [[ "$PURE_MODE" == auto ]]; then
  downloads_dir="$(xdg-user-dir DOWNLOAD 2> /dev/null || true)"
  downloads_dir="${downloads_dir:-$HOME/Downloads}"
  shopt -s nullglob
  pure_candidates=("$downloads_dir"/Pure\ 3.59*.zip)
  shopt -u nullglob
  if (( ${#pure_candidates[@]} == 1 )); then
    PURE_ARCHIVE="${pure_candidates[0]}"
  elif (( ${#pure_candidates[@]} > 1 )); then
    die "multiple Pure 3.59 archives found; select one with --pure ZIP or use --no-pure"
  fi
fi
if [[ -n "$PURE_ARCHIVE" ]]; then
  step "Checking your local Pure archive"
  pure_setup check
fi

# --------------------------------------------------------------- local HUD --

# Only install the user's original archive; do not redistribute CMRT assets.
hud_setup() { # check | install
  python3 - "$1" "$HUD_ARCHIVE" "$AC_COMMON" "$AC_DOCS" "$CACHE_DIR" <<'PY_HUD'
import configparser
from datetime import datetime
import hashlib
import io
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import stat
import sys
import tempfile
import zipfile

mode, archive, game, documents, cache = sys.argv[1:]
game, documents, cache = map(Path, (game, documents, cache))
editions = {"Essential": "1.0.13", "Complete": "2.1.3"}
components = (
    "manifest.ini", "settings/first.lua",
    "common/settings.lua", "common/players.lua", "radar/first.lua",
    "gearbox/first.lua", "leaderboard/first.lua", "tires/first.lua",
    "map/first.lua", "sectors/first.lua", "deltabar/first.lua",
    "auto_resize.ini", "manual_resize.ini", "CHANGELOG.txt",
)

def ini(path):
    c = configparser.ConfigParser(interpolation=None, strict=False)
    c.optionxform = str
    if path.exists():
        c.read(path, encoding="utf-8-sig")
    return c

def safe_members(bundle):
    seen = set()
    for member in bundle.infolist():
        name = member.filename
        p = PurePosixPath(name)
        if (not p.parts or p.is_absolute() or ".." in p.parts or "\\" in name
                or any(":" in part for part in p.parts)
                or stat.S_ISLNK(member.external_attr >> 16) or member.flag_bits & 1):
            raise SystemExit("HUD archive contains an unsafe or encrypted entry")
        if member.is_dir():
            continue
        key = str(p).casefold()
        if key in seen:
            raise SystemExit("HUD archive contains duplicate paths")
        seen.add(key)
        yield member

payload = {}
with zipfile.ZipFile(archive) as bundle:
    members = list(safe_members(bundle))
    manifests = [(m.filename, edition) for m in members for edition in editions
                 if m.filename.endswith(f"apps/lua/CMRT-{edition}-HUD/manifest.ini")]
    if len(manifests) != 1:
        raise SystemExit("Expected one original CMRT Essential or Complete HUD ZIP")
    manifest_path, edition = manifests[0]
    app_name = f"CMRT-{edition}-HUD"
    title = f"CMRT {edition} HUD"
    app = f"apps/lua/{app_name}/"
    version = editions[edition]
    other_edition = "Essential" if edition == "Complete" else "Complete"
    other_app = f"apps/lua/CMRT-{other_edition}-HUD"
    required = {app + p for p in (*components, app_name + ".lua")}
    if edition == "Complete":
        required.update(app + p for p in ("damagepanel/first.lua", "mfd/first.lua"))
    prefix = manifest_path[:-len(app + "manifest.ini")]
    for member in members:
        if member.filename.startswith(prefix + app):
            rel = member.filename[len(prefix):]
            payload[rel] = bundle.read(member)  # CRC verification before any writes
    if not required.issubset(payload):
        raise SystemExit(title + " archive is missing required components")
    manifest = configparser.ConfigParser(interpolation=None, strict=False)
    manifest.read_string(payload[app + "manifest.ini"].decode("utf-8-sig"))
    if (manifest.get("ABOUT", "VERSION", fallback="").strip() != version
            or manifest.get("ABOUT", "NAME", fallback="").strip() != title):
        raise SystemExit("Supported HUD versions: Essential 1.0.13 and Complete 2.1.3")
    # Include the author's matching flags and fuel indicator, preserving the
    # real originals locally instead of using the archive's stock backups.
    for member in members:
        if PurePosixPath(member.filename).name in (
                "CMRT_flag_and_fuel_replacement.zip",
                "CMRT_flag_fuel_and_starting_lights_replacement.zip"):
            with zipfile.ZipFile(io.BytesIO(bundle.read(member))) as graphics:
                for graphic in safe_members(graphics):
                    rel = graphic.filename
                    if ((rel.startswith(("content/gui/flags/", "content/gui/fuelIndicator/"))
                         and rel.endswith(".png") and not rel.endswith("_backup.png"))
                            or (edition == "Complete" and rel == "content/texture/off.png")):
                        if rel in payload:
                            raise SystemExit("HUD archive contains duplicate graphics")
                        payload[rel] = graphics.read(graphic)

for rel in payload:
    target = game / rel
    if target.is_symlink() or not target.resolve().is_relative_to(game.resolve()):
        raise SystemExit("HUD destination escapes the game directory")
other_path = game / other_app
if other_path.is_symlink() or not other_path.resolve().is_relative_to(game.resolve()):
    raise SystemExit("Other HUD edition escapes the game directory")
if mode == "check":
    print(f"    Verified local {title} {version} archive and file integrity")
    sys.exit(0)
if mode != "install":
    raise SystemExit("Unknown HUD operation")
csp = ini(game / "extension/config/data_manifest.ini")
csp_version = re.match(r"(\d+)\.(\d+)\.(\d+)", csp.get("VERSION", "SHADERS_PATCH", fallback=""))
if not (game / "dwrite.dll").is_file() or not csp_version or tuple(map(int, csp_version.groups())) < (0, 2, 3):
    raise SystemExit("CMRT HUD needs Custom Shaders Patch 0.2.3 or newer")

fingerprint = hashlib.sha256(Path(archive).read_bytes()).hexdigest()
install_id = hashlib.sha256(str(game.resolve()).encode()).hexdigest()[:16]
state_file = cache / "hud" / (install_id + ".json")
state = json.loads(state_file.read_text()) if state_file.exists() else {}
backup = cache / "backups" / (f"cmrt-{edition.lower()}-{version}-" + datetime.now().strftime("%Y%m%d-%H%M%S-%f"))
backed_up = set()

def write(path, data, category, rel):
    if path.is_file() and path.read_bytes() == data:
        return
    if str(path) not in backed_up:
        backed_up.add(str(path))
        if path.exists():
            dest = backup / category / rel
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, dest)
        else:
            backup.mkdir(parents=True, exist_ok=True)
            with (backup / "new-files.txt").open("a") as f:
                f.write(str(path) + "\n")
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix=".cmrt-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.chmod(temp, 0o644)
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)

video = ini(documents / "cfg/video.ini")
width = max(800, video.getint("VIDEO", "WIDTH", fallback=1920))
height = max(600, video.getint("VIDEO", "HEIGHT", fallback=1080))
gui = ini(documents / "cfg/extension/gui.ini")
ui_scale = max(0.5, gui.getfloat("NEW_UI", "UI_SCALE", fallback=1))
app_scale = round(min(2, max(0.5, height / 1080 / ui_scale)), 3)
physical_scale = app_scale * ui_scale
payload_revision = 2 if edition == "Complete" else 1
installed = (state.get("fingerprint") == fingerprint
             and state.get("payload_revision", 1) == payload_revision
             and all((game / p).is_file() for p in payload))
if not installed:
    # Change defaults in the locally supplied file. Saved preferences in CSP's
    # storage still take precedence; no third-party source is bundled here.
    rel = app + "settings/first.lua"
    settings = payload[rel].decode("utf-8-sig")
    scale_keys = ["gearbox", "sectors", "leaderboard", "tyres", "map", "deltabar", "pedals", "radar"]
    if edition == "Complete":
        scale_keys += ["damage_panel", "mfd"]
    for key in scale_keys:
        settings, count = re.subn(r"(\b" + key + r"_scale\s*=\s*)1(?=\s*,)",
                                  lambda m: m[1] + str(app_scale), settings, count=1)
        if count != 1:
            raise SystemExit("Unsupported CMRT scale settings; game files were not changed")
        if edition == "Complete":
            # Complete has both legacy migration defaults and current defaults.
            settings, count = re.subn(
                r'(\b' + key + r'_scale\s*=\s*make_setting_storage\("[^"]+",\s*)1(?=\))',
                lambda m: m[1] + str(app_scale), settings, count=1)
            if count != 1:
                raise SystemExit("Unsupported Complete scale settings; game files were not changed")
    if edition == "Complete":
        # First launch must respect the layout below. The app still saves it as
        # a custom layout, and its Reset/Default Layout controls keep working.
        settings, count = re.subn(r'(ac\.storage\("First_Time_Opening_Complete",\s*)false(?=\))',
                                 r'\g<1>true', settings, count=1)
        if count != 1:
            raise SystemExit("Unsupported Complete layout settings; game files were not changed")
    payload[rel] = settings.encode()
    if edition == "Complete":
        # Give a fresh MFD useful information even in cars without ABS, and
        # populate its drawing row immediately on the first launch.
        rel = app + "mfd/first.lua"
        mfd, count = re.subn(
            r'(MFD_PRESETS\[0\]\.mfd_row1\[1\]\s*=\s*)MFD_Type\.ABS',
            r'\g<1>MFD_Type.BRAKE_BIAS\n'
            '            MFD_PRESETS[0].mfd_row1[2] = MFD_Type.LIGHTS\n'
            '            MFD_Row1 = table.clone(MFD_PRESETS[0].mfd_row1, true)',
            payload[rel].decode("utf-8-sig"), count=1)
        if count != 1:
            raise SystemExit("Unsupported Complete MFD defaults; game files were not changed")
        payload[rel] = mfd.encode()

# Validate and prepare config before moving either edition or writing game files.
pending_cfg = {}

def save_cfg(rel, c):
    out = io.StringIO()
    c.write(out, space_around_delimiters=False)
    pending_cfg[rel] = out.getvalue().encode()

def set_values(c, section, values):
    if not c.has_section(section):
        c.add_section(section)
    for k, v in values.items():
        c.set(section, k, str(v))

acos_path = documents / "cfg/acos.ini"
acos = ini(acos_path)
same_edition = state.get("edition", "Essential") == edition
visibility = state.setdefault("edition_visibility", {})
restored_visibility = visibility.get(edition, {}) if not same_edition else {}
for section, visible in restored_visibility.items():
    if acos.has_section(section):
        set_values(acos, section, {"VISIBLE": visible})
        save_cfg("acos.ini", acos)
if not same_edition or not state.get("configured") or not acos_path.exists():
    # AC's selected desktop is one-based, while its form sections are zero-based.
    selected = min(4, max(1, acos.getint("HEADER", "DESKTOP_SELECTED", fallback=1)))
    desk = selected - 1
    cmrt_prefix = f"DESK_{desk}_FORM_IMGUI_LUA_{title}_WINDOW_"
    existing_layout = any(s.startswith(cmrt_prefix) and (s in restored_visibility or acos.get(s, "VISIBLE", fallback="0") == "1")
                          for s in acos.sections())
    if not existing_layout:
        s = physical_scale
        margin = 40 * s
        positions = {
            0: (width - 415*s, height - 175*s),       # gear, RPM, speed, fuel
            1: (width - 395*s, 65*s),                # lap and sector timing
            2: (margin, 65*s),                       # position and nearby drivers
            3: (margin, height - 260*s),             # tyre information + pedal bars
            4: (margin, height * 0.37),              # circuit map below leaderboard
            7: ((width - 303*s)/2, height - 260*s),   # low, centered radar near the bottom edge
            9: ((width - 600*s)/2, height * 0.20),    # delta below the mirror
        }
        sizes = {0: (369, 129), 1: (351, 208), 2: (427, 298), 3: (481, 249),
                 4: (357, 372), 7: (303, 318), 9: (600, 158)}
        if edition == "Complete":
            # Complete inserts Damage before Pedals, shifting Deltabar to 10.
            positions[10] = positions.pop(9)
            sizes[10] = sizes.pop(9)
            positions[8] = (width - 180*s, height - 370*s)
            sizes[8] = (140, 140)
            positions[12] = ((width - 380*s)/2, height - 370*s)
            sizes[12] = (380, 100)
        imgui = ini(documents / "cfg/extension/state/imgui_settings.ini")
        for index in range(13 if edition == "Complete" else 11):
            x, y = positions.get(index, (margin, margin))
            set_values(acos, cmrt_prefix + str(index), {
                "POSX": round(max(0, x)), "POSY": round(max(0, y)),
                "VISIBLE": int(index in positions), "BLOCKED": 0, "SCALE": 1,
            })
            if index in sizes:
                w, h = sizes[index]
                value = ",".join(str(round(v)) for v in (max(0, x), max(0, y), w*s, h*s))
                set_values(imgui, f"IMGUI_APP_POS_SIZE_{desk}", {
                    f"IMGUI_LUA_{title}_WINDOW_{index}": value,
                })
        for name in ("AC_ESSENTIALS", "LEADERBOARD_APP", "RACE_POSITION", "TYRES_APP", "KSMAP", "LAP_TIME", "FORM_GEAR", "PEDALS"):
            set_values(acos, f"DESK_{desk}_FORM_{name}", {"VISIBLE": 0})
        set_values(acos, "HEADER", {"VERSION": 2, "DESKTOP_SELECTED": selected})
        save_cfg("acos.ini", acos)
        save_cfg("extension/state/imgui_settings.ini", imgui)
        # Discard CMRT's cached window sizes so its auto-resizer does not shift
        # the new positions using dimensions from an earlier layout.
        storage_rel = f"extension/state/lua/app/{app_name}.ini"
        storage = ini(documents / "cfg" / storage_rel)
        if storage.remove_section("VEC2"):
            save_cfg(storage_rel, storage)
        gameplay = ini(documents / "cfg/gameplay.ini")
        set_values(gameplay, "OVERLAY_LEADERBOARD", {"ACTIVE": 0})
        set_values(gameplay, "VIRTUAL_MIRROR", {"ACTIVE": 1})
        if edition == "Complete":
            state.setdefault("stock_damage_display", gameplay.get("DAMAGE_DISPLAYER", "IS_ACTIVE", fallback=None))
            set_values(gameplay, "DAMAGE_DISPLAYER", {"IS_ACTIVE": 0})
        save_cfg("gameplay.ini", gameplay)
        print(f"    Arranged {len(positions)} HUD apps for {width}x{height}")
    else:
        print("    Existing CMRT layout preserved")
if edition == "Complete" and restored_visibility:
    gameplay = ini(documents / "cfg/gameplay.ini")
    state.setdefault("stock_damage_display", gameplay.get("DAMAGE_DISPLAYER", "IS_ACTIVE", fallback=None))
    set_values(gameplay, "DAMAGE_DISPLAYER", {"IS_ACTIVE": 0})
    save_cfg("gameplay.ini", gameplay)
if edition == "Complete" and same_edition and state.get("configured") and state.get("payload_revision", 1) < 2:
    # Upgrade our initial MFD placement only if it is still at our old default.
    # The user's radar position and any moved MFD are kept.
    selected = min(4, max(1, acos.getint("HEADER", "DESKTOP_SELECTED", fallback=1)))
    desk = selected - 1
    key = f"IMGUI_LUA_{title}_WINDOW_12"
    section = f"DESK_{desk}_FORM_{key}"
    imgui = ini(documents / "cfg/extension/state/imgui_settings.ini")
    coords = imgui.get(f"IMGUI_APP_POS_SIZE_{desk}", key, fallback="").split(",")
    if len(coords) == 4:
        x, y, w, h = map(float, coords)
        s = physical_scale
        if abs(x - (width - 380*s)/2) < 2 and abs(y - (height - 150*s)) < 2:
            x, y = round((width - w)/2), round(height - 370*s)
            set_values(acos, section, {"POSX": x, "POSY": y})
            set_values(imgui, f"IMGUI_APP_POS_SIZE_{desk}", {key: f"{x},{y},{w:g},{h:g}"})
            save_cfg("acos.ini", acos)
            save_cfg("extension/state/imgui_settings.ini", imgui)
# Hide the removed edition on every desktop, retaining its saved coordinates so
# an explicit switch back can recover the user's old layout.
removed_prefix = f"_FORM_IMGUI_LUA_CMRT {other_edition} HUD_WINDOW_"
if not same_edition or other_path.exists():
    previous_visibility = {s: acos.get(s, "VISIBLE", fallback="0")
                           for s in acos.sections() if removed_prefix in s}
    if previous_visibility:
        visibility[other_edition] = previous_visibility
for section in acos.sections():
    if removed_prefix in section and acos.get(section, "VISIBLE", fallback="0") != "0":
        set_values(acos, section, {"VISIBLE": 0})
        save_cfg("acos.ini", acos)

# A return to Essential also restores the stock starting lights and damage
# display that this installer replaced for Complete. Keep later user edits.
restore_light = None
light_rel = "content/texture/off.png"
light_path = game / light_rel
light_state = state.get("complete_starting_lights")
if edition == "Essential" and light_state:
    if light_path.is_file() and hashlib.sha256(light_path.read_bytes()).hexdigest() == light_state["installed_sha256"]:
        original = light_state.get("original")
        if original and Path(original).is_file():
            restore_light = Path(original).read_bytes()
        else:
            raise SystemExit("No original starting lights to restore; restore them with Steam before switching to Essential")
    state.pop("complete_starting_lights", None)
if edition == "Essential" and "stock_damage_display" in state:
    gameplay = ini(documents / "cfg/gameplay.ini")
    if "gameplay.ini" in pending_cfg:
        gameplay.read_string(pending_cfg["gameplay.ini"].decode())
    previous = state.pop("stock_damage_display")
    if gameplay.get("DAMAGE_DISPLAYER", "IS_ACTIVE", fallback=None) == "0":
        if previous is None:
            gameplay.remove_option("DAMAGE_DISPLAYER", "IS_ACTIVE")
        else:
            set_values(gameplay, "DAMAGE_DISPLAYER", {"IS_ACTIVE": previous})
        save_cfg("gameplay.ini", gameplay)

if other_path.exists():
    retired = backup / "game" / other_app
    retired.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(other_path), str(retired))
    print(f"    Backed up and removed {other_edition} HUD to avoid duplicate apps")
if not installed:
    if edition == "Complete" and light_rel in payload and not light_state:
        state["complete_starting_lights"] = {
            "original": str(backup / "game" / light_rel) if light_path.is_file() else None,
            "installed_sha256": hashlib.sha256(payload[light_rel]).hexdigest(),
        }
        # Remember even identical original files for a later edition switch.
        if light_path.is_file():
            dest = backup / "game" / light_rel
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(light_path, dest)
    for rel, data in payload.items():
        write(game / rel, data, "game", rel)
    print(f"    Installed {title} {version} with matching graphics")
else:
    print(f"    {title} {version} is already installed")
if restore_light is not None:
    write(light_path, restore_light, "game", light_rel)
for rel, data in pending_cfg.items():
    write(documents / "cfg" / rel, data, "cfg", rel)
if edition == "Essential":
    # Essential uses this directory to detect first launch; prevent its initial
    # automatic placement from replacing the positions written above.
    (documents / app_name).mkdir(parents=True, exist_ok=True)
state.update(edition=edition, version=version, payload_revision=payload_revision,
             fingerprint=fingerprint, configured=True, game=str(game.resolve()))
if backup.exists():
    state["last_backup"] = str(backup)
    print("    Backup: " + str(backup))
state_file.parent.mkdir(parents=True, exist_ok=True)
fd, temp = tempfile.mkstemp(prefix=".cmrt-state-", dir=state_file.parent)
try:
    with os.fdopen(fd, "w") as f:
        json.dump(state, f, indent=2)
        f.write("\n")
    os.replace(temp, state_file)
finally:
    if os.path.exists(temp):
        os.unlink(temp)
PY_HUD
}

# A paid download takes precedence over an old free download. Multiple copies
# of the selected edition still require an explicit path, never a guessed version.
detect_hud_archive() { # downloads directory
  local downloads_dir="$1" candidate
  local -a hud_candidates=() complete_candidates=()
  while IFS= read -r -d '' candidate; do
    case "${candidate,,}" in
      */cmrt_complete_hud*.zip) complete_candidates+=("$candidate") ;;
      */cmrt_essential_hud*.zip) hud_candidates+=("$candidate") ;;
    esac
  done < <(find "$downloads_dir" -maxdepth 1 -type f -print0 2> /dev/null)
  if (( ${#complete_candidates[@]} > 0 )); then
    hud_candidates=("${complete_candidates[@]}")
  elif [[ -d "$AC_COMMON/apps/lua/CMRT-Complete-HUD" ]]; then
    info "Keeping installed Complete HUD; use --hud ZIP to switch to Essential."
    return
  fi
  if (( ${#hud_candidates[@]} == 1 )); then
    HUD_ARCHIVE="${hud_candidates[0]}"
  elif (( ${#hud_candidates[@]} > 1 )); then
    die "multiple CMRT HUD archives found for this edition; select one with --hud ZIP or use --no-hud"
  fi
}

if [[ "$HUD_MODE" == auto ]]; then
  downloads_dir="$(xdg-user-dir DOWNLOAD 2> /dev/null || true)"
  detect_hud_archive "${downloads_dir:-$HOME/Downloads}"
fi
if [[ -n "$HUD_ARCHIVE" ]]; then
  step "Checking your local HUD archive"
  hud_setup check
fi


# ------------------------------------------------------------ plugin cache --

# Content Manager only hands out its plugins to itself, so whatever it has
# downloaded is kept here and put back into new prefixes.
has_plugins() { # directory
  compgen -G "$1/*/Manifest.json" > /dev/null
}

save_plugins() {
  local dir
  has_plugins "$CM_DATA/Plugins" || return 0
  mkdir -p "$PLUGIN_CACHE"
  for dir in "$CM_DATA/Plugins"/*/; do
    [[ -f "$dir/Manifest.json" ]] || continue
    rm -rf "${PLUGIN_CACHE:?}/$(basename "$dir")"
    cp -a "$dir" "$PLUGIN_CACHE/"
  done
}

restore_plugins() {
  local dir name
  has_plugins "$PLUGIN_CACHE" || return 0
  mkdir -p "$CM_DATA/Plugins"
  for dir in "$PLUGIN_CACHE"/*/; do
    name="$(basename "$dir")"
    [[ -e "$CM_DATA/Plugins/$name" ]] || cp -a "$dir" "$CM_DATA/Plugins/"
  done
}

save_plugins

