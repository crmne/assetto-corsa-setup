# Prints the Steam name of the installed compatibility tool built from release
# $1 (a GE-Proton tag), if there is one.
installed_tool() {
  local dir name
  for dir in "$COMPAT_TOOLS_DIR"/*/; do
    [[ -f "$dir/compatibilitytool.vdf" && -f "$dir/proton" ]] || continue
    name="$(grep -A2 '"compat_tools"' "$dir/compatibilitytool.vdf" | tail -n1 | grep -oP '"\K[^"]+' | head -n1)"
    if [[ "$name" == "$1" || "$name" == "$1-x86_64" ]]; then
      echo "$name"
      return 0
    fi
  done
  return 1
}

# Looks up a GE-Proton release: prints "tag tarball-url checksum-url".
proton_release() { # tag | latest
  local api="https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases"
  if [[ "$1" == "latest" ]]; then api="$api/latest"; else api="$api/tags/$1"; fi
  curl -fsSL "$api" | python3 -c '
import json, re, sys
release = json.load(sys.stdin)
tag = release["tag_name"]
assets = {a["name"]: a["browser_download_url"] for a in release["assets"]}
for suffix in ("-x86_64", ""):
    tarball, checksum = tag + suffix + ".tar.gz", tag + suffix + ".sha512sum"
    if tarball in assets and checksum in assets:
        print(tag, assets[tarball], assets[checksum])
        break
' 2> /dev/null || true
}

install_proton() { # tag tarball-url checksum-url
  local tarball="${2##*/}" checksum="${3##*/}"
  step "Installing $1"
  stop_steam
  download "$2" "$TMP/$tarball"
  download "$3" "$TMP/$checksum"
  (cd "$TMP" && sha512sum --quiet -c "$checksum") || die "$1 download is corrupt"
  mkdir -p "$COMPAT_TOOLS_DIR"
  tar -xzf "$TMP/$tarball" -C "$COMPAT_TOOLS_DIR"
  rm -f "$TMP/$tarball"
}

# Reads or sets the compatibility tool Steam uses for the game, in config.vdf.
compat_tool() { # get | set
  python3 - "$1" "$STEAM_DIR/config/config.vdf" "$APPID" "$TOOL_NAME" <<'PY'
import re, sys

action, path, appid, tool = sys.argv[1:5]
text = open(path, encoding="utf-8", errors="surrogateescape").read()

def block(key, start, end):
    """Span (open brace, close brace) of the block named key inside text[start:end]."""
    m = re.compile(r'"%s"\s*\{' % re.escape(key), re.I).search(text, start, end)
    if not m:
        return None
    depth, i, quoted = 0, m.end() - 1, False
    while i < end:
        c = text[i]
        if quoted:
            if c == "\\":
                i += 1
            elif c == '"':
                quoted = False
        elif c == '"':
            quoted = True
        elif c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return m.end() - 1, i
        i += 1
    return None

span = (0, len(text))
for key in ("InstallConfigStore", "Software", "Valve", "Steam"):
    found = block(key, span[0], span[1])
    if not found:
        sys.exit("cannot find %s in %s" % (key, path))
    span = found
steam = span

mapping = block("CompatToolMapping", steam[0], steam[1])
entry = block(appid, mapping[0], mapping[1]) if mapping else None
current = None
if entry:
    m = re.search(r'"name"\s+"([^"]*)"', text[entry[0]:entry[1]])
    current = m.group(1) if m else None

if action == "get":
    print(current or "")
    sys.exit(0)

if current == tool:
    sys.exit(0)

body = '\n%(t)s\t"name"\t\t"%(tool)s"\n%(t)s\t"config"\t\t""\n%(t)s\t"priority"\t\t"250"\n%(t)s'
if entry:
    indent = re.search(r"[ \t]*$", text[:entry[1]]).group(0)
    text = text[:entry[0] + 1] + body % {"t": indent, "tool": tool} + text[entry[1]:]
elif mapping:
    indent = re.search(r"[ \t]*$", text[:mapping[1]]).group(0)
    t = indent + "\t"
    new = '\t"%s"\n%s{%s}\n%s' % (appid, t, body % {"t": t, "tool": tool}, indent)
    text = text[:mapping[1]] + new + text[mapping[1]:]
else:
    indent = re.search(r"[ \t]*$", text[:steam[1]]).group(0)
    t, t2 = indent + "\t", indent + "\t\t"
    new = '\t"CompatToolMapping"\n%s{\n%s"%s"\n%s{%s}\n%s}\n%s' % (
        t, t2, appid, t2, body % {"t": t2, "tool": tool}, t, indent)
    text = text[:steam[1]] + new + text[steam[1]:]

open(path, "w", encoding="utf-8", errors="surrogateescape").write(text)
PY
}

