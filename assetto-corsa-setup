if [[ -f "$AC_COMMON/AssettoCorsa.exe" ]] && is_content_manager "$AC_COMMON/AssettoCorsa.exe"; then
  info "already installed"
else
  info "downloading..."
  download "https://acstuff.club/app/latest.zip" "$TMP/cm.zip"
  mkdir "$TMP/cm"
  unzip -q "$TMP/cm.zip" -d "$TMP/cm"
  [[ -f "$TMP/cm/Content Manager.exe" ]] || die "unexpected Content Manager download"
  # Steam puts the stock launcher back when it updates or verifies the game.
  if [[ -f "$AC_COMMON/AssettoCorsa.exe" ]]; then
    mv -f "$AC_COMMON/AssettoCorsa.exe" "$AC_COMMON/AssettoCorsa_original.exe"
  fi
  cp "$TMP/cm/Content Manager.exe" "$AC_COMMON/AssettoCorsa.exe"
  [[ ! -f "$TMP/cm/Manifest.json" ]] || cp "$TMP/cm/Manifest.json" "$AC_COMMON/"
  info "installed; the stock launcher is kept as AssettoCorsa_original.exe"
fi

if [[ ! -f "$AC_COMMON/content/fonts/system/segoeui.ttf" ]]; then
  info "installing its fonts..."
  download "https://files.acstuff.ru/shared/T0Zj/fonts.zip" "$TMP/fonts.zip"
  mkdir "$TMP/fonts"
  unzip -q "$TMP/fonts.zip" -d "$TMP/fonts"
  mkdir -p "$AC_COMMON/content/fonts"
  cp -r "$TMP/fonts/system" "$AC_COMMON/content/fonts/"
fi

installed_csp_version() {
  local manifest="$AC_COMMON/extension/config/data_manifest.ini"
  [[ -f "$manifest" && -f "$AC_COMMON/dwrite.dll" ]] || return 0
  sed -n 's/^SHADERS_PATCH=\(.*\)$/\1/p' "$manifest" | tr -d '\r' | head -n1
}

if (( INSTALL_CSP )); then
  step "Custom Shaders Patch"
  csp_installed="$(installed_csp_version)"
  if [[ -n "$csp_installed" && ( -z "$CSP_VERSION" || "$CSP_VERSION" == "$csp_installed" ) ]]; then
    info "v$csp_installed already installed"
  else
    csp_wanted="${CSP_VERSION:-$CSP_VERSION_DEFAULT}"
    info "downloading v$csp_wanted..."
    download "https://acstuff.club/patch/?get=$csp_wanted" "$TMP/csp.zip"
    unzip -tq "$TMP/csp.zip" > /dev/null || die "Custom Shaders Patch v$csp_wanted could not be downloaded"
    unzip -qo "$TMP/csp.zip" -d "$AC_COMMON"
    rm -f "$TMP/csp.zip"
    info "installed v$csp_wanted"
  fi
fi

# ------------------------------------------------ Content Manager settings --

steam_id() {
  local id
  id="$(grep -oP '"LastOwner"\s+"\K[0-9]+' "$STEAMAPPS/appmanifest_$APPID.acf" 2> /dev/null | head -n1 || true)"
  if [[ -z "$id" || "$id" == "0" ]]; then
    id="$(python3 - "$STEAM_DIR/config/loginusers.vdf" <<'PY' || true
import re, sys
try:
    text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
except OSError:
    sys.exit(0)
users = re.findall(r'"(\d{17})"\s*\{(.*?)\}', text, re.S)
recent = [u for u, body in users if re.search(r'"MostRecent"\s+"1"', body)]
print((recent or [u for u, _ in users] or [""])[0])
PY
)"
  fi
  echo "$id"
}

# Writes settings into Content Manager's Values.data, keeping everything else.
# With --get KEY, prints that setting instead.
cm_values() { # key=value... | --get key
  mkdir -p "$CM_DATA"
  python3 - "$CM_DATA/Values.data" "$@" <<'PY'
import os, sys, zlib

path, args = sys.argv[1], sys.argv[2:]

def lzf_decompress(data):
    out, i = bytearray(), 0
    while i < len(data):
        ctrl = data[i]; i += 1
        if ctrl < 32:
            out += data[i:i + ctrl + 1]; i += ctrl + 1
        else:
            length = ctrl >> 5
            if length == 7:
                length += data[i]; i += 1
            ref = len(out) - ((ctrl & 0x1F) << 8) - data[i] - 1; i += 1
            if ref < 0:
                raise ValueError("corrupt LZF data")
            for _ in range(length + 2):
                out.append(out[ref]); ref += 1
    return bytes(out)

def load(path):
    try:
        raw = open(path, "rb").read()
    except OSError:
        return b""
    if not raw:
        return b""
    if raw[0] == 11:
        return lzf_decompress(raw[1:])
    if raw[0] == 0:
        return zlib.decompress(raw[1:], -15)
    if any(b < 0x20 and b not in (9, 10, 13) for b in raw):
        return zlib.decompress(raw, -15)
    return raw

def encode(value):
    return value.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t").replace("\r", "")

try:
    lines = load(path).decode("utf-8").split("\n")
except Exception as e:
    sys.exit("cannot read %s: %s" % (path, e))
if lines and lines[0].startswith("version:"):
    if lines[0].strip() != "version: 2":
        sys.exit("%s has an unknown format (%s)" % (path, lines[0]))
    lines = lines[1:]
lines = [l for l in lines if l]

def decode(value):
    out, i = [], 0
    while i < len(value):
        if value[i] == "\\" and i + 1 < len(value):
            out.append({"n": "\n", "t": "\t"}.get(value[i + 1], value[i + 1])); i += 2
        else:
            out.append(value[i]); i += 1
    return "".join(out)

if args[:1] == ["--get"]:
    prefix = encode(args[1]) + "\t"
    found = [l[len(prefix):] for l in lines if l.startswith(prefix)]
    if not found:
        sys.exit(1)
    print(decode(found[-1]))
    sys.exit(0)

for key, value in (a.split("=", 1) for a in args):
    # "?key" only sets a default: a value already there is left alone.
    only_if_missing = key.startswith("?")
    prefix = encode(key.lstrip("?")) + "\t"
    if only_if_missing and any(l.startswith(prefix) for l in lines):
        continue
    lines = [l for l in lines if not l.startswith(prefix)]
    lines.append(prefix + encode(value))

# Content Manager reads the file as plain text when it holds no control bytes.
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8", newline="\n") as f:
    f.write("version: 2\n" + "\n".join(lines) + "\n")
os.replace(tmp, path)
PY
}

# The scale of the display the game will open on, as Content Manager's
# interface scale. Only compositors that leave X11 apps unscaled need one.
display_scale() {
  local dpi
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl > /dev/null; then
    python3 -c '
import json, subprocess
def hypr(*args):
    return json.loads(subprocess.run(["hyprctl", "-j", *args], capture_output=True, text=True).stdout)
option = hypr("getoption", "xwayland:force_zero_scaling")
if option.get("int", option.get("bool")):
    focused = [m for m in hypr("monitors") if m.get("focused")]
    print(focused[0]["scale"] if focused else 1)
else:
    print(1)
' 2> /dev/null && return 0
  fi
  if command -v xrdb > /dev/null; then
    dpi="$(xrdb -query 2> /dev/null | sed -n 's/^Xft\.dpi:[[:space:]]*\([0-9.]*\).*/\1/p' | head -n1)"
    if [[ -n "$dpi" ]]; then
      python3 -c "print($dpi / 96)"
      return 0
    fi
  fi
  echo 1
}

CM_SCALE="$(python3 -c 'import sys; print("%g" % min(max(round(float(sys.argv[1]), 2), 0.5), 4))' \
  "${SCALE:-$(display_scale)}" 2> /dev/null)" || CM_SCALE=1

configure_content_manager() {
  local values=("_ac_root=$WIN_AC_ROOT") id
  id="$(steam_id)"
  [[ -z "$id" ]] || values+=("SteamId=$id")
  restore_plugins
  # With plugins in place there is nothing left for the first-run wizard to ask.
  if has_plugins "$CM_DATA/Plugins"; then
    values+=("_wizardVersion=2" "_second_run=0")
  fi
  if [[ -n "$SCALE" ]]; then
    values+=("__uiScale_2=$CM_SCALE")
  elif [[ "$CM_SCALE" != "1" ]]; then
    values+=("?__uiScale_2=$CM_SCALE")
  fi
  # Content Manager recommends ideal text formatting at scales other than 100%.
  [[ "$CM_SCALE" == "1" ]] || values+=("?appearance_idealFormattingMode_2=True")
  cm_values "${values[@]}"

  # Lets Content Manager see which Steam account is logged in.
  mkdir -p "$PFX/drive_c/Program Files (x86)/Steam/config"
  ln -sfn "$STEAM_DIR/config/loginusers.vdf" "$PFX/drive_c/Program Files (x86)/Steam/config/loginusers.vdf"

  # Its Start Menu shortcut makes it crash on startup under Wine.
  rm -f "$WIN_USER/AppData/Roaming/Microsoft/Windows/Start Menu/Programs/Content Manager.lnk"
}

step "Configuring Content Manager"
configure_content_manager
info "game folder: $WIN_AC_ROOT"
info "interface scale: $(cm_values --get __uiScale_2 || echo 1)"
if has_plugins "$CM_DATA/Plugins"; then
  info "plugins: $(find "$CM_DATA/Plugins" -mindepth 2 -maxdepth 2 -name Manifest.json | wc -l) installed"
fi

# ---------------------------------------------------------------- first run --

# Proton builds the prefix and installs .NET and friends the first time the
# game starts. That takes minutes and shows nothing, so do it here and wait.
first_run() {
  local waited=0 last="" now
  step "Starting Assetto Corsa once so Proton can build its Wine prefix"
  info "This takes several minutes and shows no window until it is done."
  setsid -f "${STEAM_CMD[@]}" -applaunch "$APPID" > /dev/null 2>&1
  until [[ -n "$(launcher_pids)" ]]; do
    sleep 3
    (( waited += 3 ))
    if [[ -f "$PFX/winetricks.log" ]]; then
      now="$(tail -n1 "$PFX/winetricks.log")"
      [[ "$now" == "$last" ]] || { info "installed: $now"; last="$now"; }
    fi
    if (( waited > 300 )) && ! game_session_running; then
      die "Assetto Corsa stopped before its launcher came up; start it from Steam and look for a prompt"
    fi
    (( waited < FIRST_RUN_TIMEOUT )) || die "gave up after $(( FIRST_RUN_TIMEOUT / 60 )) minutes waiting for Assetto Corsa to start"
  done
  info "Content Manager came up; closing it to finish the setup."
  sleep 15
  stop_game_session
}

if [[ ! -f "$READY_MARKER" || ! -f "$PFX/user.reg" ]]; then
  first_run
  [[ -f "$PFX/user.reg" ]] || die "Proton did not create the Wine prefix"
  # Content Manager was running; make sure its settings are still what we want.
  configure_content_manager
  touch "$READY_MARKER"
else
  step "Wine prefix is already set up"
fi

if (( INSTALL_CSP )) && ! grep -qx "corefonts" "$PFX/winetricks.log" 2> /dev/null; then
  if command -v protontricks > /dev/null; then
    step "Installing the fonts Custom Shaders Patch needs (this takes a while)"
    STEAM_DIR="$STEAM_DIR" protontricks "$APPID" corefonts > "$TMP/corefonts.log" 2>&1 \
      || { tail -n 20 "$TMP/corefonts.log" >&2; warn "could not install corefonts; text in Custom Shaders Patch apps may look wrong"; }
  else
    warn "protontricks is not installed; skipping the fonts Custom Shaders Patch needs"
  fi
fi

# ------------------------------------------------- Content Manager's font --

# Proton's prefix maps Segoe UI, the font Content Manager's interface is set
# in, to Times New Roman. Selawik is Microsoft's open-source stand-in for it.
wine_regedit() { # file.reg
  local status=0
  cp "$1" "$PFX/drive_c/assetto-corsa-setup.reg"
  STEAM_DIR="$STEAM_DIR" protontricks -c 'wine regedit /S C:\\assetto-corsa-setup.reg' "$APPID" \
    > "$TMP/regedit.log" 2>&1 || status=$?
  rm -f "$PFX/drive_c/assetto-corsa-setup.reg"
  return "$status"
}

if ! command -v protontricks > /dev/null; then
  warn "protontricks is not installed; skipping Content Manager's interface font"
else
  if [[ ! -f "$PFX/drive_c/windows/Fonts/selawk.ttf" ]] || ! grep -q '^"Segoe UI"="Selawik"' "$PFX/user.reg"; then
    step "Giving Content Manager a proper interface font"
    download "https://github.com/microsoft/Selawik/releases/download/1.01/Selawik_Release.zip" "$TMP/selawik.zip"
    unzip -qo -j "$TMP/selawik.zip" '*.ttf' -d "$TMP/selawik"
    cp "$TMP/selawik/"*.ttf "$PFX/drive_c/windows/Fonts/"
    cat > "$TMP/fonts.reg" <<'EOF'
Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Wine\Fonts\Replacements]
"Segoe UI"="Selawik"
"Segoe UI Light"="Selawik Light"
"Segoe UI Semilight"="Selawik Semilight"
"Segoe UI Semibold"="Selawik Semibold"
EOF
    wine_regedit "$TMP/fonts.reg" || { tail -n 20 "$TMP/regedit.log" >&2; warn "could not set Content Manager's interface font"; }
  fi
  if ! grep -qx "fontsmooth=rgb" "$PFX/winetricks.log" 2> /dev/null; then
    step "Turning on font smoothing"
    STEAM_DIR="$STEAM_DIR" protontricks "$APPID" fontsmooth=rgb > "$TMP/fontsmooth.log" 2>&1 \
      || { tail -n 20 "$TMP/fontsmooth.log" >&2; warn "could not turn on font smoothing"; }
  fi
fi

# Pure runs after prefix setup, when both CSP and the user's cfg directory exist.
if [[ -n "$PURE_ARCHIVE" ]]; then
